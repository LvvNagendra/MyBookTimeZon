# Copy to `.env` in this folder (or set variables in your IDE Run Configuration / OS environment).
# Never commit `backend/.env` — it is gitignored.
#
# From repo root, `npm run dev` loads this file into the API process via scripts/run-spring-boot.mjs.
# If you start Spring only from the IDE, configure the same variables there (the IDE does not read this file unless you add a plugin).

# AI beauty coach (POST /api/v1/beauty-coach/chat). Server-side only; never put keys in Vite frontend env.
# Use at least one of:
OPENAI_API_KEY=
# Google AI Studio key for Gemini (OpenAI-compatible endpoint). https://aistudio.google.com/app/apikey
# Prefer GEMINI_API_KEY for Gemini; if you only set OPENAI_API_KEY by mistake, it must be sk-... (OpenAI). Google keys (AIza...) belong here or AUTO will route them to Gemini.
GEMINI_API_KEY=

# AUTO: Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set (or AIza-only in OpenAI slot → Gemini).
# Or force: OPENAI | GEMINI (see application.yml app.beauty-coach.llm).
# BEAUTY_COACH_LLM=AUTO

# Optional overrides (defaults in application.yml)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.0-flash
