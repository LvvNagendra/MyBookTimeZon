# --- Backend required for API calls (otherwise Vite proxy logs ECONNREFUSED) ---
# Option A — run API + UI together from repo root:  npm run dev
# Option B — two terminals: (1) cd backend && mvnw.cmd spring-boot:run   (2) cd frontend && npm run dev
# Option C — offline UI only:  VITE_USE_MOCK=true

# Spring Boot default in application-dev.yml is port 8090. Proxy uses IPv4 to avoid Windows localhost/IPv6 issues.
API_PROXY_TARGET=http://127.0.0.1:8090

# Use real backend via Vite proxy. Set to "true" only when the Java API is not running.
VITE_USE_MOCK=false
