# SlotNexa frontend — copy to .env.local and adjust
# Keep mock OFF for real API (Spring Boot on :8090 via Vite proxy)
VITE_USE_MOCK=false
# VITE_API_BASE_URL=https://api.yourdomain.com
# Optional: Maps Embed API (browser iframe). Geocoding uses server GOOGLE_MAPS_API_KEY.
# VITE_GOOGLE_MAPS_API_KEY=
